# Credentials for docker-compose only. Copy to `.env` beside docker-compose.yml.
# Compose reads this file automatically for ${...} substitution, and `.env` is
# git-ignored - the committed compose file must never carry a real password.
#
# Percent-encode reserved characters: @ -> %40, # -> %23, / -> %2F
DB_USER=root
DB_PASSWORD=your%40password%23here
DB_NAME=travel_ops
