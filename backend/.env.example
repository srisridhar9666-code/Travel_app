# ---------------------------------------------------------------------------
# Field Logistics & Travel Management - configuration
#
# Copy to `.env` and fill in. Never commit the result: it holds the database
# password, the token signing key, the PII encryption key and the SMTP password.
#
# The app refuses to start with ENVIRONMENT=production while any of the values
# marked [MUST CHANGE] is still at its default. That check is in
# app/core/hardening.py and it is deliberate - a misconfigured deploy that boots
# anyway looks healthy and has a published admin password.
# ---------------------------------------------------------------------------

APP_NAME="Field Logistics & Travel Management"

# "development" warns about unsafe settings. "production" refuses to start.
ENVIRONMENT=development


# --- Database --------------------------------------------------------------
# Percent-encode reserved characters in the password: @ becomes %40, # becomes
# %23, / becomes %2F. A raw @ silently truncates the host and you get a
# connection error that blames the wrong thing.
DATABASE_URL="mysql+pymysql://USER:PASSWORD@HOST:3306/travel_ops?charset=utf8mb4"


# --- Secrets ---------------------------------------------------------------
# [MUST CHANGE] Signs every access token. At least 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""

# [MUST CHANGE] Encrypts identity document numbers at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# BACK THIS UP SEPARATELY FROM THE DATABASE. A backup of both together is a
# backup of neither: lose this key and every stored Aadhaar, PAN and passport
# number is unrecoverable ciphertext. Changing it has the same effect.
PII_ENCRYPTION_KEY=""

# How long a session lasts. 480 = 8 hours, one working day.
ACCESS_TOKEN_EXPIRE_MINUTES=480


# --- Where the app lives ---------------------------------------------------
# [MUST CHANGE] Origins the API will accept browser requests from. Comma
# separated, no trailing slash. Production must not contain localhost.
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# [MUST CHANGE] Where invite and password-reset links point. Must be https in
# production, or those links travel in the clear.
FRONTEND_BASE_URL="http://localhost:5173"


# --- First administrator ---------------------------------------------------
# Created once, on first start, only if no admin exists. The routine never
# touches an existing account, so restarting cannot reset this password.
ADMIN_EMAIL="admin@designboxed.com"
ADMIN_NAME="System Admin"
# [MUST CHANGE] The default is published in the README.
ADMIN_PASSWORD="ChangeMe@123"


# --- Tenancy ---------------------------------------------------------------
# Single-tenant today. Every row carries this, so a second company is a config
# change rather than a migration.
DEFAULT_TENANT="designboxed"


# --- File storage ----------------------------------------------------------
# "local" writes to UPLOAD_DIR. Correct on one long-lived machine with a
# persistent disk.
#
# "gcs" writes to STORAGE_BUCKET. Required on any platform with an ephemeral
# filesystem - on Cloud Run an uploaded passport scan survives until the next
# deploy and no longer.
STORAGE_BACKEND="local"
STORAGE_BUCKET=""
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10

# ID proofs are purged this many days after an employee's exit date.
ID_PROOF_RETENTION_DAYS=90


# --- Gemini (ticket extraction) --------------------------------------------
# Credentials resolve in this order; the first one set wins:
#   1. GEMINI_CREDENTIALS_JSON - the service account as inline JSON, which is
#      what a secret manager hands you as an env var.
#   2. GEMINI_CREDENTIALS_PATH - a file on disk. The local development path.
#   3. Neither - Application Default Credentials. On Cloud Run this uses the
#      service account attached to the revision, which is the best option
#      available: there is no key to leak, rotate or bake into an image.
GEMINI_CREDENTIALS_PATH="../gemini_credentials.json"
GEMINI_CREDENTIALS_JSON=""
GEMINI_PROJECT_ID="db-data-team"
GEMINI_LOCATION="global"
GEMINI_EXTRACTION_MODEL="gemini-3.1-pro-preview"


# --- Email -----------------------------------------------------------------
# Off by default. A fresh checkout, a test run and CI can never send real mail
# by accident - it has to be turned on deliberately.
#
# To send with Gmail: EMAIL_ENABLED=true, SMTP_USERNAME and EMAIL_FROM set to the
# Gmail address, and SMTP_APP_PASSWORD set to an App Password (Google Account >
# Security > App passwords; needs 2-Step Verification). Restart the API, then
# GET /health/email. The start-up log names whatever is still missing.
EMAIL_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_APP_PASSWORD=""
EMAIL_FROM=""
EMAIL_FROM_NAME="Travel Ops"

# Addresses that may actually receive mail, comma separated. Empty means no
# restriction, which is what production wants. In development it is the
# difference between proving delivery works and mailing a hundred invented
# addresses at a real domain.
EMAIL_ALLOWLIST=""


# --- Reminder scheduler ----------------------------------------------------
# Off by default so a developer pointed at a production database does not start
# mailing people from their laptop.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=30

# "internal" runs the loop inside the API process. Correct whenever at least one
# instance is always alive.
#
# "external" leaves the loop stopped and expects something to call
#   POST /internal/run-reminders
# on a schedule - which is what Cloud Scheduler does. Required on any platform
# that scales to zero, where there may be no instance running when a reminder
# falls due. Reminders are deduplicated by a unique index, so triggering this
# more often than necessary is harmless.
SCHEDULER_MODE="internal"
# Required when SCHEDULER_MODE=external. The endpoint is closed without it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULER_TOKEN=""
